# systemd unit for running Tabledux on the Pi at boot.
# Install: see docs/pi-setup.md
[Unit]
Description=Tabledux table server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tabledux
Group=tabledux
# "input" lets Tabledux read the keyboard for hotkeys without root.
SupplementaryGroups=input
WorkingDirectory=/opt/tabledux
Environment=NODE_ENV=production
Environment=TABLEDUX_DATA=/var/lib/tabledux
Environment=TABLEDUX_PORT=8080
ExecStart=/usr/bin/node packages/server/dist/main.js
Restart=on-failure
RestartSec=3
StateDirectory=tabledux

[Install]
WantedBy=multi-user.target
